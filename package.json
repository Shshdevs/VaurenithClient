{
  "packageManager": "pnpm@12.18.0",
  "name": "vaurenithweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "tauri info",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint",
    "types": "tsc --noEmit --project ./tsconfig.app.json && tsc --noEmit --project ./tsconfig.node.json",
    "icons": "svgr --typescript --jsx-runtime automatic --icon --out-dir src/assets/icons src/assets/svg",
    "stylelint": "stylelint --cache --cache-location ./node_modules/.cache/.stylelint 'src/**/*.{css,scss}'",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "check": "./node_modules/.bin/tsc --noEmit --project ./tsconfig.app.json && ./node_modules/.bin/tsc --noEmit --project ./tsconfig.node.json && ./node_modules/.bin/eslint && ./node_modules/.bin/stylelint --cache --cache-location ./node_modules/.cache/.stylelint 'src/**/*.{css,scss}' && ./node_modules/.bin/prettier --cache --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "eslint --fix",
    "*.{css,scss}": "stylelint --fix",
    "*.{json,md,yml,yaml,html,css,scss,js,jsx,ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@tauri-apps/api": "^2.12.5",
    "classnames": "^2.5.1",
    "i18next": "^27.1.3",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.18.5",
    "reset-css": "^5.0.2",
    "sass": "^1.108.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "prettier": "3.8.3",
    "stylelint": "^17.16.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
