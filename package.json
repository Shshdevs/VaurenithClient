{
  "packageManager": "pnpm@12.18.0",
  "name": "vaurenithweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "types": "tsc --noEmit --project ./tsconfig.app.json && tsc --noEmit --project ./tsconfig.node.json",
    "icons": "svgr --typescript --jsx-runtime automatic --icon --out-dir src/assets/icons src/assets/svg",
    "stylelint": "stylelint --cache --cache-location ./node_modules/.cache/.stylelint 'src/**/*.{css,scss}'",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "check": "./node_modules/.bin/tsc --noEmit --project ./tsconfig.app.json && ./node_modules/.bin/tsc --noEmit --project ./tsconfig.node.json && ./node_modules/.bin/eslint && ./node_modules/.bin/stylelint --cache --cache-location ./node_modules/.cache/.stylelint 'src/**/*.{css,scss}' && ./node_modules/.bin/prettier --cache --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "eslint --fix",
    "*.{css,scss}": "stylelint --fix",
    "*.{json,md,yml,yaml,html,css,scss,js,jsx,ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "lucide-react": "^1.72.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "reset-css": "^5.0.2",
    "sass": "^1.100.0",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.4",
    "prettier": "3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-svgr": "^5.2.0"
  }
}
